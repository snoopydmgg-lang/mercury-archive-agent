{
  // ═══════════════════════════════════════════════════════════════════
  //  NEOCLASSICAL HUMANISM  ·  VS Code Design System
  //  Palette: parchment + warm charcoal + terracotta wax-seal accent
  //  Forbidden: #000, #FFF, high saturation, neon, heavy shadows
  // ═══════════════════════════════════════════════════════════════════

  // ── 1. Base Theme ─────────────────────────────────────────────────
  "workbench.colorTheme": "Quiet Light",

  // ── 2. Typography & Editor Rhythm ─────────────────────────────────
  "editor.fontFamily": "'Fira Code', 'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.tabSize": 2,
  "editor.padding.top": 8,
  "editor.padding.bottom": 8,
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.semanticHighlighting.enabled": true,

  // ── 3. Chrome Reduction — strip every non-essential element ──────
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "none",
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "none",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": false,
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.breadcrumbs.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.lightbulb.enabled": "off",
  "editor.parameterHints.enabled": false,
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": false,
  "editor.matchBrackets": "near",
  "editor.suggest.showStatusBar": false,
  "editor.renderFinalNewline": "dimmed",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "single",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",
  "git.ignoreLimitWarning": true,

  // ── 4. Language-Specific ─────────────────────────────────────────
  "[markdown]": {
    "editor.fontFamily": "'Fira Code', 'Cascadia Code', Consolas, monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.8,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[jsonc]": {
    "editor.fontFamily": "'Fira Code', 'Cascadia Code', Consolas, monospace",
    "editor.fontSize": 13
  },

  // ── 5. Zen Mode ──────────────────────────────────────────────────
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.fullScreen": false,

  // ── 5b. Terminal Typography ──────────────────────────────────────
  "terminal.integrated.fontFamily": "Cascadia Mono, Microsoft YaHei UI, Consolas, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.2,

