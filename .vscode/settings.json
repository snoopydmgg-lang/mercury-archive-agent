  // ═══════════════════════════════════════════════════════════════════
  //  7. SYNTAX HIGHLIGHTING — Warm, muted, book-like
  //     Terracotta reserved for: links, escape sequences
  // ═══════════════════════════════════════════════════════════════════
  "editor.tokenColorCustomizations": {
    "[Quiet Light]": {
      "comments": "#B8B0A8",
      "strings": "#7A9B7E",
      "numbers": "#C4755A",
      "keywords": "#615E5B",
      "types": "#8B6B5A",
      "functions": "#6B7B8D",
      "variables": "#2D2B2A",

      "textMateRules": [
        { "scope": "comment", "settings": { "foreground": "#B8B0A8", "fontStyle": "italic" } },
        { "scope": "comment.line.documentation", "settings": { "foreground": "#B8B0A8", "fontStyle": "italic" } },
        { "scope": "punctuation.definition.comment", "settings": { "foreground": "#D0CCC5" } },

        { "scope": "string", "settings": { "foreground": "#7A9B7E" } },
        { "scope": "string.quoted", "settings": { "foreground": "#7A9B7E" } },
        { "scope": "string.template", "settings": { "foreground": "#7A9B7E" } },

        { "scope": "constant.character.escape", "settings": { "foreground": "#D36B4D" } },
        { "scope": "constant.character.character-class.regexp", "settings": { "foreground": "#D36B4D" } },

        { "scope": "constant.numeric", "settings": { "foreground": "#C4755A" } },
        { "scope": "constant.language", "settings": { "foreground": "#C4755A" } },
        { "scope": "constant.language.boolean", "settings": { "foreground": "#C4755A" } },

        { "scope": "keyword.control", "settings": { "foreground": "#615E5B", "fontStyle": "bold" } },
        { "scope": "keyword.control.conditional", "settings": { "foreground": "#615E5B", "fontStyle": "bold" } },
        { "scope": "keyword.control.flow", "settings": { "foreground": "#615E5B", "fontStyle": "bold" } },
        { "scope": "keyword.operator", "settings": { "foreground": "#8A8580" } },

        { "scope": "storage.type", "settings": { "foreground": "#8B6B5A" } },
        { "scope": "storage.modifier", "settings": { "foreground": "#8B6B5A", "fontStyle": "italic" } },

        { "scope": "entity.name.function", "settings": { "foreground": "#6B7B8D" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#8B6B5A" } },
        { "scope": "entity.name.type.class", "settings": { "foreground": "#8B6B5A" } },
        { "scope": "entity.name.type.interface", "settings": { "foreground": "#8B6B5A", "fontStyle": "italic" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#8B6B5A" } },
        { "scope": "entity.other.attribute-name", "settings": { "foreground": "#C4A66A" } },
        { "scope": "entity.other.inherited-class", "settings": { "foreground": "#8B6B5A", "fontStyle": "italic" } },

        { "scope": "support.function", "settings": { "foreground": "#6B7B8D" } },
        { "scope": "support.function.builtin", "settings": { "foreground": "#6B7B8D" } },
        { "scope": "support.type", "settings": { "foreground": "#8B6B5A" } },
        { "scope": "support.constant", "settings": { "foreground": "#C4755A" } },
